import heapq

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)


def print_board(state):
    for i in range(0, 9, 3):
        print(state[i:i + 3])
    print()


# Heuristic: Manhattan Distance
def heuristic(state):
    distance = 0

    for i, tile in enumerate(state):
        if tile == 0:
            continue

        goal_index = goal.index(tile)

        row1, col1 = divmod(i, 3)
        row2, col2 = divmod(goal_index, 3)

        distance += abs(row1 - row2) + abs(col1 - col2)

    return distance


def get_neighbors(state):
    neighbors = []
    zero = state.index(0)
    row, col = divmod(zero, 3)

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        nr, nc = row + dr, col + dc

        if 0 <= nr < 3 and 0 <= nc < 3:
            new_index = nr * 3 + nc
            new_state = list(state)

            new_state[zero], new_state[new_index] = (
                new_state[new_index], new_state[zero]
            )

            neighbors.append(tuple(new_state))

    return neighbors


def a_star(start):
    # (f, g, state, path)
    pq = [(heuristic(start), 0, start, [start])]
    visited = {}

    while pq:
        f, g, state, path = heapq.heappop(pq)

        if state in visited and visited[state] <= g:
            continue

        visited[state] = g

        print("g(n):", g, "h(n):", heuristic(state),
              "f(n):", f)
        print_board(state)

        if state == goal:
            return path

        for neighbor in get_neighbors(state):
            new_g = g + 1

            if neighbor not in visited or new_g < visited[neighbor]:
                new_h = heuristic(neighbor)
                new_f = new_g + new_h

                heapq.heappush(
                    pq,
                    (new_f, new_g, neighbor, path + [neighbor])
                )

    return None


start = tuple(map(int, input(
    "Enter initial state (use 0 for blank): "
).split()))

if len(start) != 9 or set(start) != set(range(9)):
    print("Invalid input! Enter numbers 0 to 8 exactly once.")
else:
    # Check solvability for a 3x3 puzzle
    tiles = [x for x in start if x != 0]
    inversions = sum(
        tiles[i] > tiles[j]
        for i in range(len(tiles))
        for j in range(i + 1, len(tiles))
    )

    if inversions % 2 != 0:
        print("This puzzle is not solvable.")
    else:
        solution = a_star(start)

        if solution:
            print("Solution found!")
            print("Total moves:", len(solution) - 1)

            for step, state in enumerate(solution):
                print("Step", step)
                print_board(state)
        else:
            print("No solution found.")
